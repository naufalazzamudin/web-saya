# ==============================================================
# HOTEL IT INVENTORY MANAGEMENT - ENVIRONMENT CONFIGURATION
# ==============================================================
# Salin file ini menjadi .env untuk menjalankan di lokal:
#   cp .env.example .env
# ==============================================================

# Port server HTTP (default: 3000)
PORT=3000

# Lingkungan runtime aplikasi: 'development' atau 'production'
NODE_ENV=production

# Kode rahasia otoritas untuk reset password & manajemen kredensial user
# Default sistem: INNRATTAN.BJM
SECRET_CODE=INNRATTAN.BJM

# Direktori penyimpanan data permanen database JSON dan file upload
# Default: ./data (otomatis dibuat jika belum ada)
DATA_DIR=./data

# URL publik aplikasi (opsional pada server tunggal, wajib jika frontend & backend terpisah)
# Contoh: https://hotel-it-inventory.up.railway.app
APP_URL=http://localhost:3000
